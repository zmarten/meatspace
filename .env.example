# ─── Required ───
HITL_API_KEY=hitl_your-secret-key-here
ADMIN_SECRET=your-admin-secret
NODE_ENV=production

# App URL (for review links — set to your actual domain)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Supabase (production) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Webhook signing ───
HITL_WEBHOOK_SECRET=your-webhook-signing-secret

# ─── Notifications (optional — at least one recommended) ───

# Email via Resend (resend.com)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=you@example.com
NOTIFICATION_FROM=MeatSpace <noreply@yourdomain.com>

# SMS via Twilio (optional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE=+1...
NOTIFICATION_PHONE=+1...

# ─── Local dev only (not set in Cloudflare) ───
# USE_MOCK=true
