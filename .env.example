# ─── Required ───
HITL_API_KEY=hitl_your-secret-key-here
HITL_ADMIN_SECRET=your-admin-secret
NEXT_PUBLIC_HITL_ADMIN_SECRET=same-as-above

# App URL (for review links in notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Notifications (at least one recommended) ───

# Email via Resend
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=you@example.com
NOTIFICATION_FROM=MeatSpace <noreply@yourdomain.com>

# SMS via Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE=+1...
NOTIFICATION_PHONE=+1...

# ─── Webhook signing ───
HITL_WEBHOOK_SECRET=your-webhook-signing-secret

# ─── Supabase (production) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# ─── Mock mode (local dev) ───
USE_MOCK=true
